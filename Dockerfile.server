FROM alpine:3.21
RUN apk add --no-cache ca-certificates

ARG TARGETARCH

# .github/workflows/release.yml builds these binaries with cargo zigbuild and
# assembles docker-bins before publishing the official GHCR image.
# Reproduce this toolchain for memory investigations; see tests/manual/server-memory-soak.md.
COPY docker-bins/linux-${TARGETARCH}/serverbee-server /usr/local/bin/

VOLUME /data
ENV SERVERBEE_SERVER__DATA_DIR=/data
EXPOSE 9527

CMD ["serverbee-server"]
