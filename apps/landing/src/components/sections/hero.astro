---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right'
import Check from '@lucide/astro/icons/check'
import InstallCommand from '@/components/install-command.astro'
import OutLink from '@/components/out-link.astro'
import Pieces from '@/components/pieces.astro'
import Shot from '@/components/shot.astro'
import { landingCopy } from '@/i18n/copy'
import { pieceCount } from '@/lib/pieces'
import { fill } from '@/lib/release'
import { type Lang, links } from '@/lib/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = landingCopy[lang]
const hero = copy.hero
const headline = [hero.h1a, hero.h1b].join(lang === 'zh' ? '' : ' ')
---

<section id="hero" class="hero">
  <div class="wrap">
    <a class="pill" href={links.releases}>
      <span class="pill-dot" aria-hidden="true"></span>
      <b>{fill(hero.release)}</b>
      <span class="pill-link">{hero.releaseLink}<ArrowUpRight aria-hidden="true" /></span>
    </a>
    <h1 aria-label={headline}><span><Pieces text={hero.h1a} lang={lang} /></span>{' '}<span><Pieces text={hero.h1b} lang={lang} start={pieceCount(hero.h1a, lang)} /></span></h1>
    <div class="hero-row">
      <p class="hero-sub">{hero.sub}</p>
      <ul class="hero-facts">
        {
          hero.facts.map((fact) => (
            <li>
              <Check aria-hidden="true" />
              {fact}
            </li>
          ))
        }
      </ul>
    </div>
    <InstallCommand id="install" lang={lang} />
    <p class="hero-links">
      <OutLink href={links.status}>{hero.cta2}</OutLink>
      <OutLink href={links.github}>{copy.final.cta2}</OutLink>
    </p>
  </div>
  <div class="wrap hero-shot">
    <Shot
      name="fleet"
      lang={lang}
      sizes="min(100vw - 40px, 1240px)"
      mobile={{ zoom: 2.3, shiftX: 0.185, ratio: '5 / 6' }}
      eager
    />
  </div>
  {/* The carriers whose latency rides the routes. The hero scene places and fills them in. */}
  {copy.scenes.carriers.map((carrier) => <span class="route-tag" aria-hidden="true" hidden>{carrier} <b></b> ms</span>)}
</section>
