---
import Clauses from '@/components/clauses.astro'
import InstallCommand from '@/components/install-command.astro'
import OutLink from '@/components/out-link.astro'
import { landingCopy } from '@/i18n/copy'
import { type Lang, links } from '@/lib/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = landingCopy[lang].final
---

<section id="final" class="final">
  <div class="wrap">
    <h2><Clauses text={copy.h2} /></h2>
    <p class="lede">{copy.sub}</p>
    <InstallCommand id="install-final" lang={lang} />
    <p class="hero-links"><OutLink href={links.github}>{copy.cta2}</OutLink></p>
  </div>
</section>
