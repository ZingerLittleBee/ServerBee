---
import Command from '@/components/command.astro'
import Heading from '@/components/heading.astro'
import { landingCopy } from '@/i18n/copy'
import { installCommands, type Lang } from '@/lib/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = landingCopy[lang].how
const { diagram } = copy
const commands = [installCommands.docker, installCommands.agent]

/*
 * Each stat carries a small figure of what it measures, drawn from the stat's own number so the two cannot
 * disagree: the report interval paces the diagram, the binary is one block per megabyte, and the tests are one
 * dot per hundred. Resident memory is a line that stays flat.
 */
const amount = (stat: { v: string }) => Number.parseFloat(stat.v.replace(/[^\d.]/g, ''))
const period = amount(copy.stats[0]) * 1000
const megabytes = amount(copy.stats[1])
const blocks = Array.from({ length: Math.ceil(megabytes) }, (_, index) =>
  index + 1 > megabytes ? megabytes - index : 1
)
const dots = Math.round(amount(copy.stats[3]) / 100)
const SPARK = { height: 20, points: 38, width: 190 }
const spark = Array.from({ length: SPARK.points }, (_, index) => {
  const x = (index * SPARK.width) / (SPARK.points - 1)
  const y = SPARK.height / 2 + 1.3 * Math.sin(index * 2.4) * Math.cos(index * 0.7)
  return { x: x.toFixed(1), y: y.toFixed(2) }
})
const sparkPath = spark.map((point, index) => `${index ? 'L' : 'M'}${point.x} ${point.y}`).join(' ')
---

<section id="how" class="how">
  <div class="wrap">
    <Heading text={copy.h2} lang={lang} />
    <ol class="steps">
      {
        copy.steps.map((step, index) => (
          <li>
            <div class="step-text">
              <h3>{step.t}</h3>
              <p>{step.d}</p>
            </div>
            <Command command={commands[index]} lang={lang} />
          </li>
        ))
      }
    </ol>

    <div class="flow" data-period={period}>
      <div class="flow-box">
        <p class="flow-title">{diagram.agents}</p>
        <ul class="flow-list">
          {[1, 2, 3].map(() => <li><code>{diagram.agentBin}</code></li>)}
        </ul>
      </div>
      <div class="flow-wire">
        <span class="flow-wire-label">{diagram.wire}</span>
        <span class="flow-wire-note">{diagram.wireNote}</span>
      </div>
      <div class="flow-box">
        <p class="flow-title">{diagram.server}</p>
        <p class="flow-sub">{diagram.serverNote}</p>
        <ul class="flow-list">
          {diagram.serverRows.map((row) => <li>{row}</li>)}
        </ul>
      </div>
      <div class="flow-wire" aria-hidden="true"></div>
      <div class="flow-box">
        <ul class="flow-list flow-clients">
          {
            diagram.clients.map((client) => (
              <li>
                <b>{client.t}</b>
                {client.d}
              </li>
            ))
          }
        </ul>
        <span class="flow-alert" aria-hidden="true">{landingCopy[lang].scenes.alert}</span>
      </div>
    </div>

    <dl class="stats">
      {
        copy.stats.map((stat, index) => (
          <div>
            <dt>
              {stat.l}
              <span class="stat-fig" aria-hidden="true">
                {index === 0 && (
                  <span class="fig-bar">
                    <i />
                  </span>
                )}
                {index === 1 && (
                  <span class="fig-blocks" style={`--blocks:${blocks.length}`}>
                    {blocks.map((fill, block) => (
                      <i style={`--c:${block}${fill < 1 ? `;--fill:${fill.toFixed(2)}` : ''}`} />
                    ))}
                  </span>
                )}
                {index === 2 && (
                  <span class="fig-spark">
                    <svg viewBox={`0 0 ${SPARK.width} ${SPARK.height}`} preserveAspectRatio="none">
                      <path d={sparkPath} />
                      <circle r="2.2" cx={SPARK.width} cy={spark.at(-1)?.y} />
                    </svg>
                  </span>
                )}
                {index === 3 && (
                  <span class="fig-dots">
                    {Array.from({ length: dots }, (_, dot) => (
                      <i style={`--c:${dot}`} />
                    ))}
                  </span>
                )}
              </span>
            </dt>
            <dd>
              {stat.v}<sup><a href={`#note-${index + 1}`} aria-label={`${copy.noteRef} ${index + 1}`}>{index + 1}</a></sup>
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="notes">
      <h3>{copy.notesTitle}</h3>
      <ol>
        {
          copy.notes.map((note, index) => (
            <li id={`note-${index + 1}`}>
              {typeof note === 'string' ? (
                note
              ) : (
                <>
                  {note.text}<a href={note.link.href}>{note.link.label}</a>{note.after}
                </>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
