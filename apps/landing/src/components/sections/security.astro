---
import Terminal from '@lucide/astro/icons/terminal'
import Heading from '@/components/heading.astro'
import OutLink from '@/components/out-link.astro'
import Points from '@/components/points.astro'
import Shot from '@/components/shot.astro'
import { landingCopy } from '@/i18n/copy'
import type { Lang } from '@/lib/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = landingCopy[lang].security
const { grant } = copy
const scene = landingCopy[lang].scenes.grant
---

<section id="security" class="feature">
  <div class="wrap headrow">
    <Heading text={copy.h2} lang={lang} />
    <div class="feature-text">
      <p class="lede">{copy.lede}</p>
      <OutLink href={copy.link.href}>{copy.link.label}</OutLink>
    </div>
  </div>
  <div class="wrap">
    <figure class="grant" data-granted={scene.granted} data-revoked={scene.revoked} data-badge={scene.badge}>
      <div>
        <figcaption><Terminal aria-hidden="true" />{grant.caption}</figcaption>
        <pre class="grant-cmd"><code><span class="cmd-dim">$ sudo serverbee-agent grant</span> <b>terminal</b> <b>--for 30m</b> <b>--reason "{grant.reason}"</b></code></pre>
      </div>
      <dl class="grant-notes">
        <div>
          <dt>terminal</dt>
          <dd>{grant.notes.capability}</dd>
        </div>
        <div>
          <dt>--for 30m</dt>
          <dd>{grant.notes.duration}</dd>
        </div>
        <div>
          <dt>--reason</dt>
          <dd>{grant.notes.reason}</dd>
        </div>
      </dl>
    </figure>
    <Shot name="capabilities" lang={lang} sizes="min(100vw - 40px, 1240px)" mobile={{ zoom: 2.6 }} />
    <Points items={copy.points} />
  </div>
</section>
