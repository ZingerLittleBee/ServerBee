{
  "name": "serverbee",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "4.3.6",
      "@types/node": "^22.13.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "bun --filter @serverbee/web build",
    "typecheck": "bun --filter @serverbee/web typecheck && bun --filter @serverbee/docs types:check",
    "check-types": "bun run typecheck",
    "dev:web": "bun --filter @serverbee/web dev",
    "test": "bun --filter @serverbee/web test",
    "test:watch": "bun --filter @serverbee/web test:watch",
    "check": "ultracite check",
    "check:agent-navigation": "bun scripts/check-agent-navigation.ts",
    "check:integration-targets": "bun scripts/check-integration-targets.ts",
    "lint": "bun run check",
    "fix": "ultracite fix",
    "test:tooling": "bun test scripts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@serverbee/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.1.14",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "ultracite": "7.2.5"
  },
  "packageManager": "bun@1.3.4",
  "patchedDependencies": {
    "@orama/orama@3.1.18": "patches/@orama%2Forama@3.1.18.patch",
    "fumadocs-ui@16.6.16": "patches/fumadocs-ui@16.6.16.patch"
  }
}
