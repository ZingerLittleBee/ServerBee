{
  "name": "serverbee",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/node": "^22.13.14",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "tailwindcss": "^4.1.18",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@orpc/server": "^1.12.2",
      "@orpc/client": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "better-auth": "1.6.25",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "bun --filter @serverbee/web build",
    "typecheck": "bun --filter @serverbee/ui check-types && bun --filter @serverbee/web typecheck && bun --filter @serverbee/docs types:check",
    "check-types": "bun run typecheck",
    "dev:web": "turbo -F web dev",
    "test": "bun --filter @serverbee/web test",
    "test:watch": "bun --filter @serverbee/web test:watch",
    "db:push": "turbo -F @serverbee/db db:push",
    "db:studio": "turbo -F @serverbee/db db:studio",
    "db:generate": "turbo -F @serverbee/db db:generate",
    "db:migrate": "turbo -F @serverbee/db db:migrate",
    "db:local": "turbo -F @serverbee/db db:local",
    "check": "ultracite check",
    "lint": "bun run check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@serverbee/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@serverbee/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "^5",
    "ultracite": "7.2.5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.7",
    "@hono/node-server": "2.0.12",
    "@tanstack/start-server-core": "1.167.30",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "defu": "6.1.7",
    "dompurify": "3.4.12",
    "fast-uri": "3.1.4",
    "h3": "2.0.1-rc.26",
    "hono": "4.12.32",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "postcss": "8.5.24",
    "qs": "6.15.3",
    "path-to-regexp": "8.4.2",
    "serialize-javascript": "7.0.7",
    "seroval": "1.5.6",
    "seroval-plugins": "1.5.6",
    "undici": "7.29.0",
    "valibot": "1.4.2",
    "vite": "7.3.6",
    "ws": "8.21.1"
  },
  "packageManager": "bun@1.3.4"
}
